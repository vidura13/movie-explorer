# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so real credentials never reach the repository.
# ---------------------------------------------------------------------------

# TMDb credential (https://www.themoviedb.org/settings/api).
# Use the "API Read Access Token" (the long JWT), not the short v3 API key —
# it is sent as an Authorization: Bearer header, so it never appears in URLs,
# browser history or server logs. The short key only works as a ?api_key=
# query parameter and is not supported by this app.
VITE_TMDB_TOKEN=

# Optional escape hatch: force the bundled sample dataset instead of calling
# the live API. Useful for UI work without a token, for offline demos, and for
# the test suite. When VITE_TMDB_TOKEN is empty this is enabled automatically.
VITE_USE_MOCK=false
