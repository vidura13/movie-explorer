# jsdom declares `canvas` as an optional peer dependency, and npm 10.8.x has a
# known bug in its peer-resolution pass that crashes the install with
# "Cannot read properties of null (reading 'edgesOut')" when it encounters it.
# npm 11+ is not affected; on npm 10.x this line keeps `npm install` working
# out of the box instead of failing with an error that looks like a broken
# project.
legacy-peer-deps=true
